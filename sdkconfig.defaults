# We don't need a massive 64KB stack for the main task, 32KB is plenty
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=8192

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning.
# Tokio's worker threads will use this default if not explicitly configured.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=32768
# Enable PSRAM
# This adds the external RAM directly into Rust's standard allocator!
# We let ESP-IDF auto-detect the PSRAM mode (Quad vs Octal) and speed to avoid hardware mismatch aborts.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# Allow mbedTLS (HTTPS) to allocate its massive 40KB buffers in the 2MB PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Reserve 128KB of Internal SRAM strictly for DMA (prevents WiFi from stealing our Display buffer memory!)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
